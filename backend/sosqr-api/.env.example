# Supabase PostgreSQL Database URL (Session Pooler - porta 5432 para migrations e direct access)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SUA_SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth JWT Secret (Obtido em: Project Settings > API > JWT Settings > JWT Secret)
SUPABASE_JWT_SECRET="seu_jwt_secret_do_supabase_aqui"

# Administradores (IDs dos usuários do Supabase autorizados a acessar /admin)
ADMIN_USER_IDS="uuid-do-admin-1,uuid-do-admin-2"

# Porta e Threads do Puma
PORT=3000
RAILS_MAX_THREADS=5

# Rails Environment e Chave de Criptografia de Sessão
RAILS_ENV=production
SECRET_KEY_BASE="gerar_via_bin_rails_secret_ou_automatico_no_render"

# Domínios adicionais autorizados no CORS (separados por vírgula)
ALLOWED_ORIGINS="https://sosqr.vercel.app,http://localhost:5173"
