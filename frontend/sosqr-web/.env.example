# ==========================================
# Variáveis de Ambiente do SOSqr Frontend
# ==========================================

# 1. Supabase Project URL & Anon Key (Obtido em: Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. URL da API Rails 8 Backend
# Local: http://localhost:3000/api/v1
# Produção (Render): https://sosqr-api.onrender.com/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# 3. URL Pública da Aplicação Web
# Local: http://localhost:5173
# Produção (Vercel): https://sosqr.vercel.app (ou seu domínio próprio)
VITE_PUBLIC_APP_URL=http://localhost:5173